{
  "position": "left",
  "margin-right": 7,
  "modules-left": ["custom/os_button", "clock", "custom/updates"],
  "modules-center": ["custom/swaync", "hyprland/workspaces"],
  "modules-right": [
    "cpu",
    "memory",
    "battery",
    "network",
    "power-profiles-daemon",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 10 // 5 workspaces by default on every monitor
    }
  },

  "custom/os_button": {
    "format": "󰣇",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/update_check.sh",
    "on-click": "kitty -T Updates yay -Syu",
    "interval": 3600, // check every hour
    "tooltip": true,
    "tooltip-format": "Amount of packages needing update",
    "return-type": "json"
  },

  "custom/swaync": {
    "format": "",
    "on-click": "swaync-client -t -sw"
  },

  "tray": {
    "spacing": 10
  },

  "clock": {
    "format": "{:%H:%M }",
    "max-length": 25,
    // "rotate": 270,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>",
    "format-alt": "  {:%a, %d-%B-%Y}"
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },

  "memory": {
    "format": " {}%",
    "tooltip": false
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "tooltip": true,
    "tooltip-format": "{time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "signal": 8
  },

  "battery#bat2": {
    "bat": "BAT2"
  },

  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "{icon}",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "Connected to {essid}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "󰤭",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
  },

  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{icon}  {volume}%",
    "format-bluetooth": "  {volume}%",
    "format-bluetooth-muted": " 󰝟",
    "format-muted": "󰝟",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "blueman-manager"
  }
}

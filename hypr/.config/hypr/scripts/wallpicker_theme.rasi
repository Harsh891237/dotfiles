configuration {
    show-icons: true;
    icon-theme: "Papirus";
}

* {
    // font:   "GeistMono Nerd Font Mono 13";
    font: 	"Rubik 13";

    background-color:   transparent;
    text-color:         @on-surface;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

@import "colors.rasi"

window {
    location:       center;
    y-offset:	    0px;
    width:          1600px;
    border-radius:  16px;

    background-color:   @surface-container-high;
    // background-color:  rgba(0,0,0, 0.5); 
}

mainbox {
    padding:    35px;
}

inputbar {
    background-color:   @outline-variant;
    border-color:       @secondary;

    border-radius:  16px;

    padding:    10px 20px;
    spacing:    8px;
    children:   [ entry ];
}

entry {
    placeholder:        " choose wallpaper..";
    placeholder-color:  @outline;
}

message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       @on-error;
    background-color:   @error;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     25px 10px 10px;
    spacing: 	12px;
    lines:      1;
    columns:    4;

    fixed-height: true;
}

element {
    padding:        8px 1px; 
    margin: 	    1px 1px;
    spacing:        8px;
    border-radius:  16px;
    orientation: vertical;
    background-color: @surface-container-highest;
}

element normal active {
    text-color: @on-error;
}

element alternate active {
    text-color: @on-error;
}

element selected normal, element selected active {
    background-color:   @secondary;
    text-color: @surface-container;
}

element-icon {
    size:           300px;
}

element-text {
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.1;
}


